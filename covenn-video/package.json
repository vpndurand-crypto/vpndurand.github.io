{
  "name": "covenn-video-hexa",
  "private": true,
  "version": "0.1.0",
  "description": "Covenn — films produit HEXA (30 s). Couche de production vidéo indépendante des bêtas : les sources de la bêta sont vendues telles quelles dans beta/, la bêta « Capital operating system » dans beta-capital-os/ ; elles ne sont jamais modifiées.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "score": "node scripts/score.mjs",
    "score:sfx": "node scripts/score.mjs --sfx-only",
    "score:capos": "node scripts/score.mjs --film capos",
    "score:capos:sfx": "node scripts/score.mjs --film capos --sfx-only",
    "render:v5": "remotion render src/index.ts CovennHexaV5 out/covenn-hexa-v5-raw.mp4 --image-format=png --crf=8",
    "master:v5": "node scripts/master.mjs",
    "render:capos": "remotion render src/index.ts CovennCapitalOS out/covenn-capos-raw.mp4 --image-format=png --crf=8 --concurrency=1",
    "master:capos": "node scripts/master.mjs --film capos",
    "extract:capos": "node scripts/extract-capos.mjs",
    "score:v6": "node scripts/score-v6.mjs",
    "score:v6:sfx": "node scripts/score-v6.mjs --sfx-only",
    "render:v6": "remotion render src/index.ts CovennHexaV6 out/covenn-v6-raw.mp4 --image-format=png --crf=8 --concurrency=1",
    "master:v6": "node scripts/master.mjs --film v6",
    "verify:v6": "node scripts/verify-v6.mjs",
    "audit:v6": "node scripts/audit-text.mjs --film v6",
    "render": "remotion render src/index.ts CovennHexa out/covenn-hexa-30s.mp4",
    "still": "remotion still src/index.ts CovennHexaV5",
    "verify:vision": "node scripts/verify-vision.mjs",
    "verify:capos": "node scripts/verify-capos.mjs",
    "verify:values": "node scripts/verify-values.mjs",
    "verify:beta": "node scripts/verify-beta.mjs",
    "audit:text": "node scripts/audit-text.mjs",
    "audit:capos": "node scripts/audit-text.mjs --film capos",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "big.js": "6.2.2",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/big.js": "6.2.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "5.6.3"
  }
}
