{
  "name": "covenn-beta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Covenn — bêta de démonstration (candidature HEXA). Application React autonome compilée en un fichier HTML unique.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "scenario": "vite-node scripts/scenario.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vitest run && vite build && node scripts/check-dist.mjs && node scripts/check-standalone.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "big.js": "^6.2.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/big.js": "^6.2.2",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.5",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.5"
  }
}
